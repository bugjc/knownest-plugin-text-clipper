    "db:read",
    "db:write",
    "agent:tools"
  ],
  "contributions": [
    {
      "point": "workspace.action",
      "slot": "editor.header_right",
      "action": "剪藏",
      "icon": "cloud-download",
      "panel": "clipper.form"
    }
  ]
}
